# Copy this file to ".env" and fill in your own values.
# .env is ignored by git - never commit real keys.

# Which AI to use: auto | claude | gemini | mock
# auto = Claude if ANTHROPIC_API_KEY is set, else Gemini if GEMINI_API_KEY is set, else mock
LLM_PROVIDER=auto
# Set to true to use the rule-based demo even when a key is present
FORCE_MOCK_LLM=false

# Option 1 - Claude API key from https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# Option 2 - Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen

# Hunter.io API key from https://hunter.io/api-keys
HUNTER_API_KEY=
# Apollo.io key (optional alternative to Hunter). Free plans may only allow
# api/v1/mixed_people/organization_top_people (names and titles, no emails).
APOLLO_API_KEY=

# Your OWN email address - the only recipient the app will ever send to
TEST_RECIPIENT_EMAIL=
# OAuth client file downloaded from Google Cloud Console (Desktop app)
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

DATABASE_PATH=outreach.db

# Optional password for the web app (index.py). Leave empty for an open app.
APP_PASSWORD=

# Test email sender: auto (Resend if RESEND_API_KEY is set, else Gmail) | resend | gmail
EMAIL_PROVIDER=auto
# Resend API key (resend.com -> API Keys, permission: Sending access). Sign up with the
# same address as TEST_RECIPIENT_EMAIL - Resend's test sender only delivers to that address.
RESEND_API_KEY=
RESEND_FROM=Sprinto Outreach Test <onboarding@resend.dev>
